        <mxCell id="notes" value="&lt;b&gt;Notas&lt;/b&gt;&lt;br&gt;Categoria é filtro transitório de fornecedores (N:N). Produtos não têm categoria.&lt;br&gt;users contém estado mínimo de sessão e recuperação; comparações não são persistidas.&lt;br&gt;schema_migrations é uma tabela técnica adicional, fora das 8 tabelas de negócio.&lt;br&gt;Seed: 5 categorias, 10 fornecedores, 50 produtos, 20 vínculos, 294 ofertas." style="rounded=1;whiteSpace=wrap;html=1;align=left;spacing=16;fillColor=#FFF7E8;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="40" y="1050" width="1880" height="120" as="geometry" />
        </mxCell>
      </root>
