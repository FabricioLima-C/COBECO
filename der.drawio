          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="relation6" value="1 : N" edge="1" parent="1" source="categories" target="supplier_categories" style="edgeStyle=orthogonalEdgeStyle;html=1;startArrow=ERone;endArrow=ERmany;strokeColor=#226451;">
          <mxGeometry relative="1" as="geometry" />
