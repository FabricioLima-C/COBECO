<mxfile host="app.diagrams.net" agent="COBECO MySQL" version="24.0.0">
  <diagram id="cobeco-mysql" name="COBECO — DER MySQL">
    <mxGraphModel page="1" pageWidth="1980" pageHeight="1300" grid="1">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="&lt;b&gt;COBECO v3.1 — MySQL / InnoDB&lt;/b&gt;&lt;br&gt;8 tabelas de negócio · SQL parametrizado · transações · utf8mb4 · UTC" style="text;html=1;align=center;fontSize=20;" vertex="1" parent="1">
          <mxGeometry x="40" y="10" width="1880" height="55" as="geometry" />
        </mxCell>
        <mxCell id="users" value="&lt;b&gt;users&lt;/b&gt;&lt;hr&gt;id BIGINT PRIMARY KEY AUTO_INCREMENT&lt;br&gt;username VARCHAR(30) NOT NULL UNIQUE&lt;br&gt;email VARCHAR(254) NOT NULL UNIQUE&lt;br&gt;name VARCHAR(100) NOT NULL&lt;br&gt;password_hash VARCHAR(255) NOT NULL&lt;br&gt;security_question VARCHAR(200) NOT NULL&lt;br&gt;security_answer_hash VARCHAR(255) NOT NULL&lt;br&gt;session_version INT NOT NULL DEFAULT 0&lt;br&gt;refresh_hash CHAR(64) NULL&lt;br&gt;reset_hash CHAR(64) NULL&lt;br&gt;reset_expires_at DATETIME(6) NULL&lt;br&gt;created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)&lt;br&gt;updated_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6)&lt;br&gt;deleted_at DATETIME(6) NULL&lt;br&gt;CHECK (CHAR_LENGTH(username) BETWEEN 3 AND 30)&lt;br&gt;CHECK (CHAR_LENGTH(name) BETWEEN 2 AND 100)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#FFEBEE;fontSize=11;strokeColor=#557766;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="430" height="413" as="geometry" />
        </mxCell>
        <mxCell id="categories" value="&lt;b&gt;categories&lt;/b&gt;&lt;hr&gt;id BIGINT PRIMARY KEY AUTO_INCREMENT&lt;br&gt;name VARCHAR(100) NOT NULL UNIQUE&lt;br&gt;description VARCHAR(255) NULL" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#E8F5E9;fontSize=11;strokeColor=#557766;" vertex="1" parent="1">
          <mxGeometry x="1470" y="90" width="430" height="114" as="geometry" />
        </mxCell>
        <mxCell id="suppliers" value="&lt;b&gt;suppliers&lt;/b&gt;&lt;hr&gt;id BIGINT PRIMARY KEY AUTO_INCREMENT&lt;br&gt;name VARCHAR(100) NOT NULL&lt;br&gt;cnpj CHAR(14) NOT NULL UNIQUE&lt;br&gt;active BOOLEAN NOT NULL DEFAULT TRUE&lt;br&gt;created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#E8F5E9;fontSize=11;strokeColor=#557766;" vertex="1" parent="1">
          <mxGeometry x="1000" y="90" width="430" height="160" as="geometry" />
        </mxCell>
        <mxCell id="supplier_categories" value="&lt;b&gt;supplier_categories&lt;/b&gt;&lt;hr&gt;supplier_id BIGINT NOT NULL&lt;br&gt;category_id BIGINT NOT NULL&lt;br&gt;PRIMARY KEY (supplier_id, category_id)&lt;br&gt;FOREIGN KEY (supplier_id) REFERENCES suppliers(id) ON DELETE CASCADE&lt;br&gt;FOREIGN KEY (category_id) REFERENCES categories(id) ON DELETE CASCADE" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#E8F5E9;fontSize=11;strokeColor=#557766;" vertex="1" parent="1">
          <mxGeometry x="1470" y="440" width="430" height="160" as="geometry" />
        </mxCell>
        <mxCell id="products" value="&lt;b&gt;products&lt;/b&gt;&lt;hr&gt;id BIGINT PRIMARY KEY AUTO_INCREMENT&lt;br&gt;name VARCHAR(160) NOT NULL&lt;br&gt;unit VARCHAR(10) NOT NULL DEFAULT &amp;#x27;un&amp;#x27;&lt;br&gt;active BOOLEAN NOT NULL DEFAULT TRUE&lt;br&gt;created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)&lt;br&gt;INDEX idx_product_name (name)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#E8F5E9;fontSize=11;strokeColor=#557766;" vertex="1" parent="1">
          <mxGeometry x="510" y="750" width="430" height="183" as="geometry" />
        </mxCell>
        <mxCell id="supplier_products" value="&lt;b&gt;supplier_products&lt;/b&gt;&lt;hr&gt;supplier_id BIGINT NOT NULL&lt;br&gt;product_id BIGINT NOT NULL&lt;br&gt;price DECIMAL(12,2) NOT NULL&lt;br&gt;stock INT NOT NULL DEFAULT 0&lt;br&gt;active BOOLEAN NOT NULL DEFAULT TRUE&lt;br&gt;PRIMARY KEY (supplier_id, product_id)&lt;br&gt;FOREIGN KEY (supplier_id) REFERENCES suppliers(id) ON DELETE CASCADE&lt;br&gt;FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE RESTRICT&lt;br&gt;CHECK (price &amp;gt;= 0)&lt;br&gt;CHECK (stock &amp;gt;= 0)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#E8F5E9;fontSize=11;strokeColor=#557766;" vertex="1" parent="1">
          <mxGeometry x="1000" y="700" width="430" height="275" as="geometry" />
        </mxCell>
        <mxCell id="lists" value="&lt;b&gt;lists&lt;/b&gt;&lt;hr&gt;id BIGINT PRIMARY KEY AUTO_INCREMENT&lt;br&gt;user_id BIGINT NOT NULL&lt;br&gt;name VARCHAR(100) NOT NULL&lt;br&gt;created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)&lt;br&gt;updated_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6) ON UPDATE CURRENT_TIMESTAMP(6)&lt;br&gt;deleted_at DATETIME(6) NULL&lt;br&gt;FOREIGN KEY (user_id) REFERENCES users(id) ON DELETE CASCADE&lt;br&gt;CHECK (CHAR_LENGTH(name) BETWEEN 1 AND 100)&lt;br&gt;INDEX idx_user_created (user_id, created_at DESC)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#E3F2FD;fontSize=11;strokeColor=#557766;" vertex="1" parent="1">
          <mxGeometry x="510" y="90" width="430" height="252" as="geometry" />
        </mxCell>
        <mxCell id="list_items" value="&lt;b&gt;list_items&lt;/b&gt;&lt;hr&gt;id BIGINT PRIMARY KEY AUTO_INCREMENT&lt;br&gt;list_id BIGINT NOT NULL&lt;br&gt;product_id BIGINT NOT NULL&lt;br&gt;quantity INT NOT NULL&lt;br&gt;created_at DATETIME(6) NOT NULL DEFAULT CURRENT_TIMESTAMP(6)&lt;br&gt;FOREIGN KEY (list_id) REFERENCES lists(id) ON DELETE CASCADE&lt;br&gt;FOREIGN KEY (product_id) REFERENCES products(id) ON DELETE RESTRICT&lt;br&gt;UNIQUE (list_id, product_id)&lt;br&gt;CHECK (quantity BETWEEN 1 AND 9999)" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=12;fillColor=#E3F2FD;fontSize=11;strokeColor=#557766;" vertex="1" parent="1">
          <mxGeometry x="510" y="410" width="430" height="252" as="geometry" />
        </mxCell>
